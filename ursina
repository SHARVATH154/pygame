from ursina import *
app = Ursina()

player =  Entity(model="cube",color=color.green,scale=1,position=(0,1,0))
ground = Entity(model='plane',texture="white_cube",collider="box",scale=10,texture_scale=(10,10))
camera_rotation = (0,6,-10)
camera_rotation_x = 30
speed = 5
def update():
    if held_keys["w"]:
        player.z -= speed * time.dt
    if held_keys["s"]:
        player.z += speed * time.dt
    if held_keys["a"]:
        player.x -= speed * time.dt
    if held_keys["d"]:
        player.x += speed * time.dt
    if held_keys["q"]:
        player.y -= speed * time.dt
    if held_keys["e"]:
        player.y += speed * time.dt
app.run()
