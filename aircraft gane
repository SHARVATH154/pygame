import  pygame
import random
pygame.init()
WIDTH, HEIGHT = 800, 600
Screen = pygame.display.set_mode((800,600))
pygame.display.set_caption("aircraft game")
black = (0,0,0)
stars = []
for i in range(100):
      stars.append({
    "x" : random.randint(0,WIDTH),
    "y" : random.randint(0,HEIGHT),
    "size" : random.uniform(1,3),
    "speed" : random.uniform(0.5,2)
  })
def draw_background():
  for s in stars:
    s["y"] += s["speed"]
    if s["y"] > HEIGHT:
      s["y"] = 0
      s["x"] = random.randint(0,WIDTH)
    a = min(225 , int(s["brightness"]))
    pygame.draw.circle(Screen,(a,a,min(255,a+38))  ,(int(s["x"]),int(s["y"])),s["size"])
class Player:
  def __init__(self):
    self.width = 48
    self.height = 56
    self.x = WIDTH // 2 - self.width // 2
    self.Y =  HEIGHT  - self.height - 20
  def draw(self):
    cx = self.x + self.width // 2
    flame_h = random.randint(10,20)
    pygame.draw.polygon(Screen,(255,100,0),[
       (cx - 10,self.Y + self.height),
       (cx + 10,self.Y + self.height),
       (cx,self.Y + self.height + flame_h)
      
    ])
    pygame.draw.polygon(Screen,(30,144,255),[
      (cx , self.Y)
      (cx + 14 , self.Y + 28)
      (cx + 10,self.Y + self.height)
      (cx - 10,self.Y + self.height)
      (cx - 14,self.Y + 28)  
    ])
    pygame.draw.polygon(Screen,(0,90,200),[
      (cx + 14,self.Y + 22),
      (cx + 38,self.Y + 46),
      (cx + 10,self.Y + 36)
    ])
    pygame.draw.ellipse(Screen,(100,230,255),
                       (cx - 5,self.Y + 6,10,16))
PLAYER = Player()
running = True
while running:
  Screen.fill(black)
  draw_background()
  for event in pygame.event.get():
      if event.type == pygame.QUIT:
        running = False
  pygame.display.update()
pygame.quit()

